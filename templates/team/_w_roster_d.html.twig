{# TM·D — GROUPED BY POSITION.

   Two levels: departments, and inside each one its positions, each headed by
   THE PERMISSIONS THAT POSITION GRANTS. Four Rangers hold one identical set —
   so a wrong grant is not four mistakes to find, it is one band to read.

   And this is the only direction in which THE TWO ANALYSTS ARE VISIBLY TWO
   JOBS: same word, different departments, different permissions, and no screen
   anywhere can quietly merge them.

   It bands twice, so it is the longest of the six, and it hides tier almost
   completely. #}
{% import '@UhifadhiTeam/team/_bits.html.twig' as bits %}

<div class="c" data-tm data-tm-dir="d">
    <span class="tab">Roster<span class="src">&middot; grouped by position</span></span>

    <p class="use" style="margin:2px 0 14px">Two levels: <b>departments</b>, and inside each one its positions,
    each headed by <b>the permissions that position grants</b>. People holding one identical set read as one thing
    &mdash; so a wrong grant is not four mistakes to find, it is one band to read. And this is the only direction
    in which <b>two same-named positions are visibly two jobs</b>: same word, different departments, different
    permissions, and no screen anywhere can quietly merge them.</p>

    <div class="tm-scroll">
        <table class="tbl">
            <thead><tr><th>Person</th><th>Tier</th><th>Ranger code</th><th>Account</th><th></th></tr></thead>
            <tbody>
                {% for department, positions in groupedPositions %}
                    {% set inDept = everybody|filter(p => p.position and (p.position.department ? p.position.department.name : '') == department) %}
                    <tr class="tm-deptrow"><td colspan="5"><div class="tm-deptband">
                        <span class="dtag"><i class="dot"></i>{{ department is empty ? 'No department yet' : department }}</span>
                        <span class="n">{{ positions|length }} position{{ positions|length == 1 ? '' : 's' }} &middot; {{ inDept|length }} {{ inDept|length == 1 ? 'person' : 'people' }}</span>
                    </div></td></tr>

                    {% for position in positions %}
                        {% set holders = everybody|filter(p => p.position == position) %}
                        <tr class="tm-bandrow inner"><td colspan="5"><div class="tm-band">
                            <b>{{ position.name }}</b><span class="n">{{ holders|length }} holder{{ holders|length == 1 ? '' : 's' }}</span>
                            <span class="gr">
                                {%- for value in position.permissionValues -%}
                                    <span class="perm">{{ value }}</span>
                                {%- else -%}
                                    <span class="perm none">grants nothing</span>
                                {%- endfor -%}
                            </span>
                        </div></td></tr>
                        {% for person in holders %}
                            <tr class="tm-memrow inner{{ person.isActive ? '' : ' tm-off' }}">
                                <td class="tm-in">{{ bits.person(person, person == app.user) }}</td>
                                <td>{{ bits.tier_pill(person.teamRole) }}</td>
                                <td>{{ bits.ranger_code(person) }}</td>
                                <td>{{ bits.account_cell(person) }}</td>
                                <td class="tm-acts">{{ bits.open_button(person) }}</td>
                            </tr>
                        {% else %}
                            {# A POSITION NOBODY HOLDS IS A REAL THING — created
                               before its first person — so it is drawn empty
                               rather than skipped. Skipping it would make the
                               page disagree with the "8 of 9 held" count above. #}
                            <tr class="tm-memrow inner"><td colspan="5"><span class="tm-nopos">{{ bits.icon_info() }}nobody holds this yet</span></td></tr>
                        {% endfor %}
                    {% endfor %}
                {% endfor %}

                {# THE UNPLACED. Somebody with no position belongs to no
                   department either, so they cannot appear in any band above —
                   and leaving them off the page would be the roster quietly
                   losing the people it most needs to show. #}
                {% set unplaced = everybody|filter(p => p.position is null) %}
                {% if unplaced|length %}
                    <tr class="tm-deptrow"><td colspan="5"><div class="tm-deptband">
                        <span class="dtag un"><i class="dot un"></i>No position</span>
                        <span class="n">{{ unplaced|length }} {{ unplaced|length == 1 ? 'person' : 'people' }}</span>
                    </div></td></tr>
                    {% for person in unplaced %}
                        <tr class="tm-memrow inner{{ person.isActive ? '' : ' tm-off' }}">
                            <td class="tm-in">{{ bits.person(person, person == app.user) }}</td>
                            <td>{{ bits.tier_pill(person.teamRole) }}</td>
                            <td>{{ bits.ranger_code(person) }}</td>
                            <td>{{ bits.account_cell(person) }}</td>
                            <td class="tm-acts">{{ bits.open_button(person) }}</td>
                        </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
</div>
