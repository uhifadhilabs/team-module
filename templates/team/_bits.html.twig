{% macro icon_search() %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>{% endmacro %}

{# Two letters, because a roster of twelve faces nobody has uploaded is a roster
   of twelve identical grey circles. #}
{% macro initials(user) %}{{ (user.firstName|default('?')|slice(0, 1) ~ user.lastName|default('?')|slice(0, 1))|upper }}{% endmacro %}

{% macro tier_pill(tier) %}
    {%- set klass = {'super_admin': 't-super', 'admin': 't-admin', 'staff': 't-staff'} -%}
    <span class="tier {{ klass[tier.value] }}">{{ tier.label }}</span>
{% endmacro %}

{# THE PERSON CELL, and it does not wrap. A name broken across two lines in a
   dense table is the one thing that makes the table stop reading as rows. #}
{% macro person(user, isYou) %}
    {% import _self as bits %}
    <div class="who">
        <span class="avatar sm">{{ bits.initials(user) }}</span>
        <b>{{ user.fullName }}</b>
        {%- if isYou %}<span class="tm-you">you</span>{% endif -%}
    </div>
    <a class="tm-mail" href="mailto:{{ user.email }}">{{ user.email }}</a>
{% endmacro %}

{# THE THREE-LINE POSITION CELL: the qualified name, then what it grants, then
   the administrator mark if the position carries team.manage.

   IT IS NEVER A BARE NAME. Two departments may own the word "Analyst", so
   "Analyst" is not a shorter way of saying the same thing — it is a different
   and ambiguous thing.

   AND IT IS NOT A COUNT FOR THE TWO TOP TIERS. A Super Admin's position may
   hold eight permissions and they decide nothing for that person: the voter
   grants by tier before it ever looks at a position, so a count here would name
   the wrong cause. It reads "everything, by tier" instead. #}
{% macro position_cell(user, positionsPath) %}
    {% import _self as bits %}
    {%- set position = user.position -%}
    {%- if position is null -%}
        <span class="tm-nopos">{{ bits.icon_info() }}no position</span>
        {%- if user.teamRole.canManageContent -%}
            <span class="tm-grants">everything, by tier</span>
        {%- else -%}
            <span class="tm-grants none">holds nothing</span>
        {%- endif -%}
    {%- else -%}
        <a class="tm-pos qual" href="{{ positionsPath }}">
            {%- if position.department %}<span class="q">{{ position.department.name }}</span><span class="sep">/</span>{% endif -%}
            <span class="n">{{ position.name }}</span>
        </a>
        {%- if user.teamRole.canManageContent -%}
            <span class="tm-grants">everything, by tier</span>
        {%- else -%}
            {%- set granted = position.permissionValues|length -%}
            <span class="tm-grants{{ granted ? '' : ' none' }}">{{ granted ? granted ~ ' granted' : 'holds nothing' }}</span>
        {%- endif -%}
        {%- if position.hasPermissionValue('team.manage') -%}
            <span class="tm-mgr">{{ bits.icon_shield() }}team.manage</span>
        {%- endif -%}
    {%- endif -%}
{% endmacro %}

{% macro ranger_code(user) %}
    {%- if user.rangerCode -%}<span class="tm-code">{{ user.rangerCode|upper }}</span>
    {%- else -%}<span class="tm-code none">&mdash;</span>{%- endif -%}
{% endmacro %}

{# THE ACCOUNT CELL — TWO INDEPENDENT AXES, and the pills never merge.
   active/deactivated is one fact and verified/never-signed-in is another; a
   person can be any combination, and the awkward one is both at once.

   THE INVITATION LINE RIDES BESIDE "never signed in" AND NOWHERE ELSE. Once
   somebody has signed in, the invitation has done its job and stops being news.
   Its null is meaningful: an account created with a password was never invited
   by anybody, so it says so by saying "created directly". #}
{% macro account_cell(user) %}
    {% import _self as bits %}
    {%- set deactivated = not user.isActive -%}
    {%- set arrived = user.isVerified -%}
    {%- if deactivated or not arrived -%}<span class="tm-accts">{% endif -%}

    {%- if deactivated -%}
        <span class="tm-acct off">{{ bits.icon_off() }} Deactivated</span>
    {%- endif -%}

    {%- if arrived and not deactivated -%}
        <span class="tm-acct ok">{{ bits.icon_check() }}Verified</span>
    {%- elseif not arrived -%}
        <span class="tm-acct new">{{ bits.icon_clock() }}Never signed in</span>
        {%- if user.wasInvited -%}
            <span class="tm-inv">invited by <b>{{ user.invitedBy ? user.invitedBy.fullName : 'somebody since removed' }}</b> &middot; {{ bits.ago(user.invitedAt) }}</span>
        {%- else -%}
            <span class="tm-inv none">created directly &middot; no invitation</span>
        {%- endif -%}
    {%- elseif deactivated -%}
        <span class="tm-acct ok">{{ bits.icon_check() }}Verified</span>
    {%- endif -%}

    {%- if deactivated or not arrived -%}</span>{% endif -%}
{% endmacro %}

{# "3 days ago" — coarse on purpose. Whether an invitation went out on Tuesday
   afternoon or Tuesday evening is not a fact anybody acts on; whether it went
   out three days ago or three months ago is. #}
{% macro ago(when) %}
    {%- if when is null -%}&mdash;
    {%- else -%}
        {%- set days = date().diff(when).days -%}
        {%- if days == 0 -%}today
        {%- elseif days == 1 -%}yesterday
        {%- elseif days < 31 -%}{{ days }} days ago
        {%- elseif days < 365 -%}{{ (days / 30)|round(0, 'floor') }} months ago
        {%- else -%}{{ (days / 365)|round(0, 'floor') }} years ago
        {%- endif -%}
    {%- endif -%}
{% endmacro %}

{# The row's one action, and its WORD changes with the state: a deactivated
   account's most useful next step is the one that undoes it. #}
{% macro open_button(user) %}
    <a class="open-btn" href="{{ path('team_member', {uuid: user.uuidString}) }}">{{ user.isActive ? 'Open' : 'Reactivate' }}</a>
{% endmacro %}
