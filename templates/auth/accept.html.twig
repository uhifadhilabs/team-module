{% extends '@UhifadhiTeam/auth/_card.html.twig' %}
{% import '@UhifadhiTeam/auth/_card.html.twig' as card %}

{% block title %}Accept your invitation{% endblock %}

{% block auth_card %}
    {% if state == 'open' %}
        <form class="c" method="post">
            {{ card.brand() }}
            <p class="auth-lede">You have been added to this installation. Choose a password and it is yours.</p>
            {{ card.error(error|default(null)) }}
            <div class="auth-for">
                <span class="avatar" style="border-style:dashed">&mdash;</span>
                <span class="who-t">
                    <b>{{ member.email }}</b>
                    {% if member.invitedBy %}<em>invited by {{ member.invitedBy.fullName }}</em>{% endif %}
                </span>
            </div>
            {# "Invited by" is a line the model can now back rather than guess
               at: invitedAt and invitedBy were ruled in for exactly this card.
               A person emailed a link to an unfamiliar product deserves to know
               who added them. #}

            <div class="auth-field">
                <label for="name">Your name</label>
                <input class="fld" id="name" name="name" placeholder="Hawa Rajabu" required autofocus>
            </div>
            <p class="auth-fine" style="border-top:0;padding-top:0;margin:-9px 0 15px">Asked here rather than
            guessed by whoever invited you. The invitation carried an address and nothing else.</p>

            {{ card.rules(minLength) }}

            <div class="auth-field">
                <label for="pw">Choose a password</label>
                <input class="fld" id="pw" type="password" name="password" autocomplete="new-password" minlength="{{ minLength }}" required>
            </div>
            <input type="hidden" name="_token" value="{{ csrfToken }}">
            <button class="cta" type="submit">Set it and sign in</button>
            <p class="auth-fine">Setting a password is what marks the account <code>isVerified</code>. Until you
            do, the team list shows you as <b>never signed in</b> &mdash; the verification fact &mdash; with
            <b>who invited you and when</b> beside it.</p>
        </form>

    {% elseif state == 'done' %}
        <div class="c">
            {{ card.brand() }}
            <p class="auth-lede">Your account is ready.</p>
            <div class="auth-said">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                <div><b>The password is set and the invitation is spent.</b> The link cannot be used again.</div>
            </div>
            <a class="cta" href="{{ path('team_login') }}" style="display:block;text-align:center;text-decoration:none;margin-top:18px">Sign in</a>
        </div>

    {% else %}
        <div class="c">
            {{ card.brand() }}
            <p class="auth-lede">That invitation is no longer open.</p>
            <div class="auth-stale">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                <div><b>The link has been used, or it was withdrawn.</b> If you already set a password, sign in
                with it. If you did not, ask whoever invited you to send a new one &mdash; nothing about your
                account is broken.</div>
            </div>
            <a class="cta" href="{{ path('team_login') }}" style="display:block;text-align:center;text-decoration:none">Go to sign in</a>
        </div>
    {% endif %}
{% endblock %}
