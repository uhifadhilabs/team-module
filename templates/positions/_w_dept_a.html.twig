{# DEPT·A — one table banded by department, with the create row inside its own
   band. The department is the STRUCTURE of the page rather than a column on it. #}
{% import '@UhifadhiTeam/positions/_bits.html.twig' as pm %}

<div class="c" data-pm="dept-a">
    <span class="tab"><span class="idx">DP&middot;A</span>Department-first<span class="src">&middot; one banded table</span></span>
    <p class="use" style="margin-top:2px">Every position under the department that owns it, and the control that
    makes a new one <b>inside the band it will belong to</b> &mdash; so a position is never created without a
    department by accident.</p>

    <div class="tm-scroll">
        <table class="tbl">
            <thead><tr><th>Position</th><th>Holders</th><th>Grants</th><th></th></tr></thead>
            <tbody>
                {% for department, group in groupedPositions %}
                    <tr class="tm-deptrow"><td colspan="4"><div class="tm-deptband">
                        <span class="dtag"><i class="dot"></i>{{ department is empty ? 'No department yet' : department }}</span>
                        <span class="n">{{ group|length }} position{{ group|length == 1 ? '' : 's' }}</span>
                    </div></td></tr>
                    {% for position in group %}
                        {% set held = holders[position.uuidString]|default(0) %}
                        <tr>
                            <td><b>{{ position.name }}</b></td>
                            <td>{% if held %}{{ held }}{% else %}<span class="pm-held0">nobody yet</span>{% endif %}</td>
                            <td>{% for value in position.permissionValues %}<span class="perm">{{ value }}</span>{% else %}<span class="perm none">nothing</span>{% endfor %}</td>
                            <td class="tm-acts"><a class="open-btn" href="{{ path('team_positions', {position: position.uuidString}) }}">Edit</a></td>
                        </tr>
                    {% endfor %}
                    <tr><td colspan="4">
                        <form class="assign" method="post" action="{{ path('team_position_create') }}">
                            <input type="hidden" name="_token" value="{{ csrfToken }}">
                            <input type="hidden" name="department" value="{{ (departments|filter(d => d.name == department)|first).uuidString|default('') }}">
                            <input type="text" name="name" class="fld" placeholder="New position in {{ department is empty ? 'no department' : department }}" required>
                            <button class="softbtn acc" type="submit">{{ pm.icon_plus() }} Add</button>
                        </form>
                    </td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
